generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum PipelineState {
  DRAFT
  ANALYZING
  CONTINUITY_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
  GENERATION_QUEUED
  FAILED
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id          String                @id
  email       String                @unique
  displayName String
  provider    String
  providerSubject String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships ProductionMembership[]
  pipelines   PipelineRun[]
  ownedSeries Series[]

  @@unique([provider, providerSubject])
}

model Series {
  id               String                @id
  title            String
  logline          String
  genre            String
  targetAudience   String
  visualStyle      String
  episodeCount     Int
  episodeDurationSeconds Int
  status           String
  ownerId          String
  owner            User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships      ProductionMembership[]
  characters       Character[]
  locations        Location[]
  episodes         Episode[]
  memoryFacts      SeriesMemoryFact[]
  storyEvents      StoryEvent[]
  storyFacts       StoryFact[]
  pipelines        PipelineRun[]
  generationJobs   GenerationJob[]
  captionTracks    CaptionTrack[]
  episodeAssemblies EpisodeAssembly[]
  episodeExportJobs EpisodeExportJob[]
  launchPackages    EpisodeLaunchPackage[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([ownerId, updatedAt])
}

model ProductionMembership {
  id        String   @id
  userId    String
  seriesId  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([seriesId, role])
}

model Character {
  id               String   @id
  seriesId         String
  name             String
  role             String
  description      String?
  age              Int
  ageRange         String?
  appearance       String
  wardrobe         String
  personality      String
  relationships    Json
  voiceProfile     Json
  continuityNotes  String[]
  status           String   @default("active")
  series           Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([seriesId, name])
}

model Location {
  id          String   @id
  seriesId    String
  name        String
  description String
  type        String?
  visualDescription String?
  roomDetails String?
  lighting    String?
  visualStyle String?
  props       Json
  continuityNotes String[]
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seriesId, name])
}

model Episode {
  id          String         @id
  seriesId    String
  episodeNumber Int
  title       String
  hook        String
  synopsis    String
  cliffhanger String
  status      String         @default("draft")
  estimatedDurationSeconds Int?
  series      Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  pipelines   PipelineRun[]
  evaluations DramaEvaluation[]
  storyFacts  StoryFact[]
  generationJobs GenerationJob[]
  captionTracks CaptionTrack[]
  assemblies EpisodeAssembly[]
  exportJobs EpisodeExportJob[]
  launchPackages EpisodeLaunchPackage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([seriesId, episodeNumber])
  @@index([seriesId, updatedAt])
}

model Scene {
  id          String   @id
  episodeId   String
  sceneNumber Int
  title       String
  description String
  locationId  String
  timeOfDay   String?
  estimatedDurationSeconds Int?
  status      String   @default("draft")
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shots       Shot[]
  storyFacts  StoryFact[]
  captionTracks CaptionTrack[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([episodeId, sceneNumber])
}

model Shot {
  id                       String   @id
  seriesId                 String
  episodeId                String
  sceneId                  String
  shotNumber               Int
  title                    String?
  shotType                 String?
  cameraAngle              String?
  framing                  String
  cameraMovement           String
  description              String
  dialogue                 String?
  durationSeconds          Int
  characterIds             String[]
  locationId               String
  continuityRequirements   Json
  visualPrompt             String
  negativePrompt           String?
  continuityNotes          String[]
  status                   String   @default("draft")
  scene                    Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  storyboard              Storyboard?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([sceneId, shotNumber])
  @@index([seriesId, episodeId, sceneId])
}

model Storyboard {
  id               String   @id
  shotId           String   @unique
  prompt           String
  referenceUrl     String?
  generationStatus String   @default("placeholder")
  provider         String?
  generationJobId  String?
  width            Int
  height           Int
  aspectRatio      String
  version          Int      @default(1)
  shot             Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SeriesMemoryFact {
  id               String   @id
  seriesId         String
  subjectType      String
  subjectId        String
  key              String
  value            String
  validFromEpisode Int
  validFromScene   Int?
  validFromShot    Int?
  validToEpisode   Int?
  validToScene     Int?
  validToShot      Int?
  source           String
  confidence       Float
  override         Boolean  @default(false)
  series           Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([seriesId, subjectType, subjectId, key])
  @@index([seriesId, validFromEpisode, validToEpisode])
}

model StoryEvent {
  id          String   @id
  seriesId    String
  eventType   String
  description String
  episodeNumber Int?
  sceneNumber Int?
  occurredAt  DateTime?
  metadata    Json
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seriesId, episodeNumber, eventType])
}

model StoryFact {
  id               String   @id
  seriesId         String
  episodeId        String?
  sceneId          String?
  subjectType      String
  subjectId        String?
  category         String
  description      String
  validFromEpisode Int?
  validUntilEpisode Int?
  source           String
  confidence       Float?
  metadata         Json
  series           Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode          Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  scene            Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([seriesId, category, validFromEpisode, validUntilEpisode])
  @@index([seriesId, subjectType, subjectId])
}

model PipelineRun {
  id              String              @id
  seriesId        String
  episodeId       String
  initiatedById   String
  state           PipelineState
  output          Json?
  generationJobId String?
  error           String?
  series          Series              @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode         Episode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  initiatedBy     User                @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  stages          PipelineStage[]
  executions      AgentExecution[]
  approvals       ApprovalDecision[]
  generationJobs  GenerationJob[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([seriesId, episodeId, state])
  @@index([initiatedById, updatedAt])
}

model PipelineStage {
  id         String              @id
  pipelineId String
  stageKey   String
  status     AgentExecutionStatus
  output     Json?
  metadata   Json
  startedAt  DateTime?
  completedAt DateTime?
  pipeline   PipelineRun         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, stageKey])
}

model AgentExecution {
  id          String              @id
  pipelineId  String?
  agent       String
  seriesId    String
  episodeId   String?
  input       Json
  output      Json?
  status      AgentExecutionStatus
  confidence  Float?
  explanation String?
  timestamp   DateTime
  durationMs  Int
  errors      Json
  metadata    Json
  pipeline    PipelineRun?        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@index([seriesId, episodeId, timestamp])
  @@index([pipelineId, agent])
}

model ApprovalDecision {
  id              String         @id
  pipelineId      String
  status          ApprovalStatus
  requestedAction String
  summary         String
  projectedImpact String
  requestedAt     DateTime
  decisionAt      DateTime?
  decisionNote    String?
  pipeline        PipelineRun    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId, status])
}

model GenerationJob {
  id              String             @id
  pipelineId      String?
  seriesId        String
  episodeId       String?
  provider        String
  providerModel   String?
  providerVoiceId String?
  characterId     String?
  language        String?
  locale          String?
  model           String
  status          GenerationJobStatus
  promptVersion   String
  inputHash       String
  estimatedCost   Float
  actualCost      Float              @default(0)
  retryCount      Int                @default(0)
  sceneId         String?
  shotId          String?
  providerJobId   String?
  generationType  String             @default("video")
  promptSnapshot  String             @default("")
  negativePromptSnapshot String?
  generationParameters Json?
  durationSeconds Int                @default(0)
  aspectRatio     String             @default("9:16")
  errorCode       String?
  retryable       Boolean?
  cancelledAt     DateTime?
  outputAssetIds  String[]
  errorMessage    String?
  lastProviderStatus String?
  lastPolledAt    DateTime?
  lastProviderError String?
  providerMetadata Json?
  completionMetadata Json?
  pipeline        PipelineRun?       @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  series          Series             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode         Episode?           @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  submittedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  updatedAt       DateTime           @updatedAt
  assets          GeneratedAsset[]

  @@index([seriesId, status, createdAt])
  @@index([pipelineId])
  @@index([provider, providerJobId])
}

model GeneratedAsset {
  id              String   @id
  generationJobId String
  seriesId        String
  episodeId       String
  sceneId         String
  shotId          String
  assetType       String
  uri             String
  storageUri      String?
  mimeType        String
  width           Int
  height          Int
  durationSeconds Float?
  fileSize        Int?
  provider        String
  providerJobId   String?
  providerModel   String?
  providerVoiceId String?
  characterId     String?
  language        String?
  locale          String?
  sourceTextSnapshot String?
  codec           String?
  sampleRate      Int?
  bitrate         Int?
  channels        Int?
  fingerprint     String
  checksum        String?
  generationParameters Json?
  promptSnapshot  String?
  negativePromptSnapshot String?
  costMetadata    Json?
  version         Int      @default(1)
  parentAssetId   String?
  preferred       Boolean  @default(false)
  supersededAt    DateTime?
  reviewStatus    String   @default("pending")
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reviews         MediaReview[]

  @@index([seriesId, episodeId, sceneId, shotId])
  @@unique([generationJobId])
}

model MediaReview {
  id                    String   @id
  seriesId              String
  episodeId             String
  sceneId               String
  shotId                String
  generationJobId       String
  assetId               String
  reviewerActor         String
  status                String
  notes                 String?
  rejectionReason       String?
  continuityAssessment  String
  asset                 GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  reviewedAt            DateTime?

  @@index([seriesId, episodeId, sceneId, shotId, assetId])
}

model CaptionTrack {
  id            String   @id
  seriesId      String
  episodeId     String
  sceneId       String?
  language      String
  format        String
  source        String
  provider      String?
  content       String
  version       Int      @default(1)
  reviewStatus  String   @default("pending")
  preferred     Boolean  @default(false)
  generatedAt   DateTime
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNotes   String?
  supersededAt  DateTime?
  series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  scene         Scene?   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  segments      CaptionSegment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([seriesId, episodeId, language, format])
  @@index([episodeId, preferred])
}

model CaptionSegment {
  id          String       @id
  trackId     String
  sequence    Int
  sceneId     String
  shotId      String?
  startMs     Int
  endMs       Int
  text        String
  speaker     String?
  characterId String?
  confidence  Float?
  track       CaptionTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, sequence])
  @@index([sceneId, shotId])
}

model EpisodeAssembly {
  id                    String   @id
  seriesId              String
  episodeId             String
  captionTrackId        String?
  captionIncluded       Boolean
  timelineDurationMs    Int
  aspectRatio           String
  width                 Int
  height                Int
  frameRate             Int
  exportPreset          String
  status                String
  reviewState           String
  reviewNotes           String?
  reviewedBy            String?
  reviewedAt            DateTime?
  validationPassed      Boolean
  validatedAt           DateTime?
  inputHash             String
  explanation           String
  createdBy             String
  version               Int
  preferred             Boolean  @default(false)
  rebuiltFromAssemblyId String?
  supersededAt          DateTime?
  generatedAt           DateTime
  series                Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode               Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  items                 EpisodeAssemblyItem[]
  validationIssues      AssemblyValidationIssue[]
  exportJobs            EpisodeExportJob[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([episodeId, version])
  @@index([seriesId, episodeId, preferred])
  @@index([episodeId, inputHash])
}

model EpisodeAssemblyItem {
  id                      String   @id
  assemblyId              String
  sequence                Int
  sceneId                 String
  shotId                  String
  videoAssetId            String?
  audioAssetId            String?
  videoSelectionReason    String?
  audioSelectionReason    String?
  startMs                 Int
  endMs                   Int
  sourceVideoDurationMs   Int?
  sourceAudioDurationMs   Int?
  trimInMs                Int
  trimOutMs               Int
  transitionType          String
  transitionDurationMs    Int
  volume                  Float
  muted                   Boolean
  videoAudioPolicy        String
  dialogueRequired        Boolean
  assembly                EpisodeAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([assemblyId, sequence])
  @@index([sceneId, shotId])
}

model AssemblyValidationIssue {
  id          String   @id
  assemblyId  String
  code        String
  severity    String
  message     String
  sequence    Int?
  sceneId     String?
  shotId      String?
  assetId     String?
  assembly    EpisodeAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([assemblyId, severity, code])
}

model EpisodeExportJob {
  id              String   @id
  seriesId        String
  episodeId       String
  assemblyId      String
  assemblyVersion Int
  exportVersion   Int
  preset          String
  outputFormat    String
  aspectRatio     String
  width           Int
  height          Int
  frameRate       Int
  videoCodec      String
  audioCodec      String
  captionMode     String
  captionTrackId  String?
  engine          String
  engineJobId     String?
  status          String
  progress        Int
  approvalState   String
  requestedBy     String
  explanation     String
  approvedBy      String?
  approvalNotes   String?
  outputUri       String?
  sidecarUri      String?
  outputFileName  String?
  fileSize        Int?
  durationMs      Int?
  checksum        String?
  engineMetadata  Json?
  errorCode       String?
  errorMessage    String?
  retryable       Boolean?
  retryCount      Int      @default(0)
  requestedAt     DateTime
  approvedAt      DateTime?
  rejectedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  cancelledAt     DateTime?
  series          Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  assembly        EpisodeAssembly @relation(fields: [assemblyId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([episodeId, exportVersion])
  @@index([seriesId, episodeId, status])
  @@index([assemblyId, createdAt])
}

model EpisodeLaunchPackage {
  id                  String   @id
  seriesId            String
  episodeId           String
  version             Int
  inputHash           String
  status              String
  preferred           Boolean  @default(false)
  preparedBy          String
  explanation         String
  seriesTitle         String
  episodeNumber       Int
  episodeTitle        String
  approvedAssetIds    String[]
  captionTrackId      String?
  captionSidecarUri   String?
  rightsAttestations  Json
  approvalSummary     Json
  continuitySummary   Json
  readinessSnapshot   Json
  validatedAt         DateTime?
  requestedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  supersededAt        DateTime?
  series              Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode             Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  manifest            DeliveryManifest?
  approvalHistory     LaunchApprovalRecord[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([episodeId, version])
  @@index([seriesId, episodeId, preferred])
  @@index([episodeId, inputHash])
}

model DeliveryManifest {
  id                    String   @id
  packageId             String   @unique
  manifestVersion       String
  seriesId              String
  episodeId             String
  assemblyId            String
  assemblyVersion       Int
  exportJobId           String
  exportVersion         Int
  outputId              String
  outputFormat          String
  width                 Int
  height                Int
  aspectRatio           String
  videoCodec            String
  audioCodec            String
  durationMs            Int
  fileSize              Int
  checksum              String
  captionMode           String
  captionSidecarUri     String?
  completedAt           DateTime
  approvalState         String
  safeOutputUri         String
  package               EpisodeLaunchPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([seriesId, episodeId, exportJobId])
}

model LaunchApprovalRecord {
  id          String   @id
  packageId   String
  actorId     String
  decision    String
  note        String
  decidedAt   DateTime
  package     EpisodeLaunchPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, decidedAt])
}

model DramaEvaluation {
  id                  String   @id
  episodeId           String
  pipelineId          String?
  hookStrength        Int
  conflict            Int
  emotionalIntensity  Int
  cliffhanger         Int
  continuity          Int
  pacing              Int
  overall             Int
  recommendations     String[]
  episode             Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())

  @@index([episodeId, createdAt])
}
