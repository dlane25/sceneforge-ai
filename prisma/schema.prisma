generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GenerationJob {
  id              String   @id
  provider        String
  model           String
  status          String
  promptVersion   String
  inputHash       String
  estimatedCost   Float
  actualCost      Float    @default(0)
  retryCount      Int      @default(0)
  outputAssetIds  String[]
  errorMessage    String?
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt
}

model ContinuityFact {
  id                String   @id
  seriesId          String
  subjectType       String
  subjectId         String
  key               String
  value             String
  validFromEpisode  Int
  validFromScene    Int?
  validFromShot     Int?
  validToEpisode    Int?
  validToScene      Int?
  validToShot       Int?
  source            String
  confidence        Float
  override          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([seriesId, subjectType, subjectId, key])
  @@index([seriesId, validFromEpisode, validToEpisode])
}

model AgentExecution {
  id          String   @id
  agent       String
  seriesId    String
  episodeId   String?
  input       Json
  output      Json?
  status      String
  confidence  Float?
  explanation String?
  timestamp   DateTime
  durationMs  Int
  errors      Json
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([seriesId, episodeId, timestamp])
}

model PipelineRun {
  id              String   @id
  seriesId        String
  episodeId       String
  state           String
  output          Json?
  generationJobId String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([seriesId, episodeId, state])
}

model ApprovalDecision {
  id              String   @id
  pipelineId      String
  status          String
  requestedAction String
  summary         String
  projectedImpact String
  requestedAt     DateTime
  decisionAt      DateTime?
  decisionNote    String?

  @@index([pipelineId, status])
}
