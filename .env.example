# Explicit local mode: no provider calls and deterministic test fixtures.
NODE_ENV=development
AUTH_MODE=mock
MEDIA_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock

# Gemini structured AI/image providers (server-only; never expose as NEXT_PUBLIC_*).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Vertex Veo production configuration (Google ADC is used server-side).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_VIDEO_MODEL=veo-3.1-generate-001
VERTEX_OUTPUT_STORAGE_URI=gs://your-bucket/sceneforge/

# Optional provider endpoint overrides for controlled environments/tests.
GEMINI_API_ENDPOINT=
VERTEX_AI_ENDPOINT=
