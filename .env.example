# SceneForge environment contract. Copy to .env.local for local work only.
# Never commit real credentials and never rename private values to NEXT_PUBLIC_*.

# -----------------------------------------------------------------------------
# Local development (deterministic, no provider calls)
# -----------------------------------------------------------------------------
NODE_ENV=development
AUTH_MODE=mock
MEDIA_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
AUDIO_PROVIDER=mock
EXPORT_ENGINE=mock
DEFAULT_AUDIO_LANGUAGE=en

# -----------------------------------------------------------------------------
# Production application, database, and Auth.js (required for launch)
# -----------------------------------------------------------------------------
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@host:5432/sceneforge
# APP_BASE_URL=https://sceneforge.example.com
# AUTH_URL=https://sceneforge.example.com
# AUTH_MODE=authjs
# AUTH_SECRET=
# AUTH_TRUST_HOST=true
# Configure at least one complete OAuth provider pair.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Optional for multi-instance Server Action key consistency; see production docs.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Production AI/media providers (server-only)
# -----------------------------------------------------------------------------
# IMAGE_PROVIDER=gemini-image
# VIDEO_PROVIDER=vertex-video
# AUDIO_PROVIDER=elevenlabs-voice
# MEDIA_PROVIDER may be omitted when operation-specific providers are configured.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Vertex uses Google Application Default Credentials supplied by the runtime.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_VIDEO_MODEL=veo-3.1-generate-001
VERTEX_OUTPUT_STORAGE_URI=gs://your-managed-bucket/sceneforge/

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Optional controlled-environment endpoint overrides. Production endpoints must
# remain approved HTTPS provider origins.
GEMINI_API_ENDPOINT=
VERTEX_API_ENDPOINT=
ELEVENLABS_API_ENDPOINT=

# -----------------------------------------------------------------------------
# Production export and managed file references
# -----------------------------------------------------------------------------
# EXPORT_ENGINE=ffmpeg-local
FFMPEG_PATH=ffmpeg
EXPORT_MEDIA_ROOT=
EXPORT_OUTPUT_ROOT=

# Unified operations stale thresholds in milliseconds.
STALE_APPROVAL_MS=86400000
STALE_QUEUED_MS=1800000
STALE_PROCESSING_MS=7200000

# Test/CI uses the same explicit mock values as local development and a dummy
# DATABASE_URL only for `prisma generate/validate`; it never opens that URL.
