# Explicit local mode: no provider calls and deterministic test fixtures.
NODE_ENV=development
AUTH_MODE=mock
MEDIA_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
AUDIO_PROVIDER=mock
DEFAULT_AUDIO_LANGUAGE=en
EXPORT_ENGINE=mock

# Gemini structured AI/image providers (server-only; never expose as NEXT_PUBLIC_*).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Vertex Veo production configuration (Google ADC is used server-side).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_VIDEO_MODEL=veo-3.1-generate-001
VERTEX_OUTPUT_STORAGE_URI=gs://your-bucket/sceneforge/

# ElevenLabs speech generation (server-only; required when AUDIO_PROVIDER=elevenlabs-voice).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Optional provider endpoint overrides for controlled environments/tests.
GEMINI_API_ENDPOINT=
VERTEX_API_ENDPOINT=
ELEVENLABS_API_ENDPOINT=

# Optional local production renderer (server-only). Absolute roots are required
# when EXPORT_ENGINE=ffmpeg-local; never expose them with NEXT_PUBLIC_* names.
FFMPEG_PATH=ffmpeg
EXPORT_MEDIA_ROOT=
EXPORT_OUTPUT_ROOT=
